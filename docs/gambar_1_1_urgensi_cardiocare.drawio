  <diagram name="Urgensi CARDIOCARE" id="urgensi1">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== BOX 1: Tingginya Mortalitas ==================== -->
        <mxCell id="2"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#D9D9D9;padding:8px 12px;font-size:13px;font-weight:bold;border-bottom:1.5px solid #333333;text-align:center&quot;&gt;&amp;#9888; Tingginya Mortalitas Penyakit Jantung di Indonesia&lt;/div&gt;&lt;div style=&quot;padding:10px 16px;font-size:11px;line-height:1.7&quot;&gt;&amp;bull; Penyakit jantung merupakan penyebab kematian tertinggi di Indonesia&lt;br&gt;&amp;bull; Jumlah kasus terus meningkat setiap tahun akibat perubahan gaya hidup&lt;br&gt;&amp;bull; Diperlukan upaya deteksi dini untuk menurunkan risiko komplikasi fatal&lt;/div&gt;&lt;/div&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;arcSize=8;verticalAlign=top;overflow=hidden;"
          vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="600" height="150" as="geometry" />
        </mxCell>

        <!-- ==================== ARROW 1→2 ==================== -->
        <mxCell id="a1" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endFill=1;" edge="1" source="2" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOX 2: Keterbatasan Manual ==================== -->
        <mxCell id="3"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#D9D9D9;padding:8px 12px;font-size:13px;font-weight:bold;border-bottom:1.5px solid #333333;text-align:center&quot;&gt;&amp;#128203; Keterbatasan Metode Deteksi Manual&lt;/div&gt;&lt;div style=&quot;padding:10px 16px;font-size:11px;line-height:1.7&quot;&gt;&amp;bull; Proses analisis data pasien masih dilakukan secara manual&lt;br&gt;&amp;bull; Membutuhkan waktu yang relatif lama untuk menghasilkan diagnosis&lt;br&gt;&amp;bull; Rentan terhadap subjektivitas dan kesalahan manusia (human error)&lt;br&gt;&amp;bull; Sulit menangani volume data pasien yang besar secara efisien&lt;/div&gt;&lt;/div&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;arcSize=8;verticalAlign=top;overflow=hidden;"
          vertex="1" parent="1">
          <mxGeometry x="150" y="230" width="600" height="180" as="geometry" />
        </mxCell>

        <!-- ==================== ARROW 2→3 ==================== -->
        <mxCell id="a2" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endFill=1;" edge="1" source="3" target="4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOX 3: Peluang Machine Learning ==================== -->
        <mxCell id="4"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#D9D9D9;padding:8px 12px;font-size:13px;font-weight:bold;border-bottom:1.5px solid #333333;text-align:center&quot;&gt;&amp;#9881; Peluang Pemanfaatan Machine Learning&lt;/div&gt;&lt;div style=&quot;padding:10px 16px;font-size:11px;line-height:1.7&quot;&gt;&amp;bull; Machine Learning mampu membantu prediksi risiko penyakit secara akurat&lt;br&gt;&amp;bull; Mampu mengolah data dalam jumlah besar secara cepat dan konsisten&lt;br&gt;&amp;bull; Algoritma Decision Tree menghasilkan aturan if-then yang mudah dipahami&lt;br&gt;&amp;bull; Cocok digunakan sebagai sistem pendukung pengambilan keputusan klinis&lt;/div&gt;&lt;/div&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;arcSize=8;verticalAlign=top;overflow=hidden;"
          vertex="1" parent="1">
          <mxGeometry x="150" y="470" width="600" height="180" as="geometry" />
        </mxCell>

        <!-- ==================== ARROW 3→4 ==================== -->
        <mxCell id="a3" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endFill=1;" edge="1" source="4" target="5" parent="1">
          <mxGeometry relative="1" as="geometry" />
