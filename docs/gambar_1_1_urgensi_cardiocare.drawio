        <!-- ==================== BOX 5: CARDIOCARE (SOLUSI) ==================== -->
        <mxCell id="6"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#C0C0C0;padding:10px 12px;font-size:14px;font-weight:bold;border-bottom:2px solid #000000;text-align:center&quot;&gt;&amp;#128187; CARDIOCARE&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Sistem Prediksi Risiko Penyakit Jantung Berbasis Web&lt;br&gt;Menggunakan Algoritma Decision Tree&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:10px 16px;font-size:11px;line-height:1.7&quot;&gt;&amp;bull; Input data pasien berbasis web (usia, gender, BMI, tekanan darah, keluhan)&lt;br&gt;&amp;bull; Prediksi tingkat risiko penyakit jantung secara real-time&lt;br&gt;&amp;bull; Penyajian hasil prediksi secara cepat beserta alur keputusan (decision path)&lt;br&gt;&amp;bull; Mendukung pengambilan keputusan medis tenaga kesehatan RSU Aulia&lt;/div&gt;&lt;/div&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=2;arcSize=8;verticalAlign=top;overflow=hidden;"
