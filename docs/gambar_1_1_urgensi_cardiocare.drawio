        <!-- ==================== BOX 4: Kebutuhan RSU Aulia ==================== -->
        <mxCell id="5"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#D9D9D9;padding:8px 12px;font-size:13px;font-weight:bold;border-bottom:1.5px solid #333333;text-align:center&quot;&gt;&amp;#127973; Kebutuhan pada RSU Aulia&lt;/div&gt;&lt;div style=&quot;padding:10px 16px;font-size:11px;line-height:1.7&quot;&gt;&amp;bull; RSU Aulia membutuhkan sistem pendukung deteksi dini penyakit jantung&lt;br&gt;&amp;bull; Membantu tenaga medis dalam menganalisis data rekam medis pasien&lt;br&gt;&amp;bull; Mendukung visi transformasi digital dan pelayanan kesehatan yang efektif&lt;/div&gt;&lt;/div&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;arcSize=8;verticalAlign=top;overflow=hidden;"
          vertex="1" parent="1">
          <mxGeometry x="150" y="710" width="600" height="155" as="geometry" />
        </mxCell>

