          vertex="1" parent="1">
          <mxGeometry x="500" y="340" width="170" height="150" as="geometry" />
        </mxCell>

        <!-- ===== BOX 5: Entropy Setelah Split ===== -->
        <mxCell id="205"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#C8C8C8;padding:5px 8px;font-size:11px;font-weight:bold;text-align:center;border-bottom:1.5px solid #333&quot;&gt;Entropy Setelah Split&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;font-size:10px;line-height:1.6&quot;&gt;&lt;b&gt;Entropy&lt;sub&gt;split&lt;/sub&gt;&lt;/b&gt; =&lt;br&gt;(10.570/27.817 &amp;#215; 0,190) +&lt;br&gt;(17.247/27.817 &amp;#215; 0,690)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:11px&quot;&gt;Entropy&lt;sub&gt;split&lt;/sub&gt; &amp;#8776; 0,500&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;"
