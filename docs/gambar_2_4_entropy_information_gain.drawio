          vertex="1" parent="1">
          <mxGeometry x="340" y="115" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- ===== BOX 3: Child Kiri (Usia ≤ 38) ===== -->
        <mxCell id="203"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#D5D5D5;padding:5px 8px;font-size:11px;font-weight:bold;text-align:center;border-bottom:1px solid #555&quot;&gt;Usia &amp;#8804; 38&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;font-size:10px;line-height:1.55&quot;&gt;Positif = 320&lt;br&gt;Negatif = 10.250&lt;br&gt;&lt;b&gt;Entropy &amp;#8776; 0,190&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Node lebih homogen&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;"
