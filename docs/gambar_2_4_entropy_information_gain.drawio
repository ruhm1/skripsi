          vertex="1" parent="1">
          <mxGeometry x="280" y="340" width="170" height="150" as="geometry" />
        </mxCell>

        <!-- ===== BOX 4: Child Kanan (Usia > 38) ===== -->
        <mxCell id="204"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#D5D5D5;padding:5px 8px;font-size:11px;font-weight:bold;text-align:center;border-bottom:1px solid #555&quot;&gt;Usia &gt; 38&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;font-size:10px;line-height:1.55&quot;&gt;Positif = 3.202&lt;br&gt;Negatif = 14.045&lt;br&gt;&lt;b&gt;Entropy &amp;#8776; 0,690&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Masih mengandung variasi kelas&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;"
