        <!-- ===== CAPTION ===== -->
        <mxCell id="220"
          value="&lt;i&gt;Perhitungan Entropy dan Information Gain digunakan untuk menentukan atribut terbaik sebagai node pemisah pada algoritma Decision Tree. Atribut dengan nilai Information Gain tertinggi dipilih untuk membentuk struktur pohon keputusan.&lt;/i&gt;"
