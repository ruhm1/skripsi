  <diagram name="Entropy &amp; Information Gain" id="ig4">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== TITLE ===== -->
        <mxCell id="200"
          value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Gambar 2.4 Ilustrasi Perhitungan Entropy dan Information Gain&lt;br&gt;pada Node Decision Tree&lt;/font&gt;&lt;/b&gt;"
          style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontColor=#000000;"
          vertex="1" parent="1">
          <mxGeometry x="310" y="8" width="580" height="40" as="geometry" />
        </mxCell>

        <!-- ===== BOX 1: Dataset Awal (Parent Node) ===== -->
        <mxCell id="201"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:0;margin:0&quot;&gt;&lt;div style=&quot;background:#C0C0C0;padding:6px 10px;font-size:12px;font-weight:bold;text-align:center;border-bottom:2px solid #000&quot;&gt;Dataset Awal&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;font-size:10px;line-height:1.6&quot;&gt;&lt;b&gt;Total Data = 27.817&lt;/b&gt;&lt;br&gt;Kelas Positif = 3.522&lt;br&gt;Kelas Negatif = 24.295&lt;br&gt;&lt;hr style=&quot;border:0;border-top:1px solid #999;margin:6px 0&quot;&gt;&lt;b&gt;Entropy(S)&lt;/b&gt; = &amp;#8722;p&amp;#8330; log&amp;#8322;(p&amp;#8330;) &amp;#8722; p&amp;#8331; log&amp;#8322;(p&amp;#8331;)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:11px&quot;&gt;Entropy(S) &amp;#8776; 0,548&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;arcSize=6;verticalAlign=top;overflow=hidden;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="220" height="220" as="geometry" />
        </mxCell>

        <!-- ===== BOX 2: Decision Node ===== -->
        <mxCell id="202"
          value="&lt;b style=&quot;font-size:12px&quot;&gt;Usia &amp;#8804; 38?&lt;/b&gt;"
