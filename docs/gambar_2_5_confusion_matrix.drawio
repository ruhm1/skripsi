        <!-- ===== CELL: FN (False Negative) — bottom-left ===== -->
        <mxCell id="309"
          value="&lt;div style=&quot;font-family:Times New Roman;text-align:center;padding:4px&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;FN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(False Negative)&lt;/font&gt;&lt;hr style=&quot;border:0;border-top:1px solid #aaa;margin:4px 8px&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Pasien berisiko&lt;br&gt;tetapi diprediksi&lt;br&gt;tidak berisiko.&lt;/font&gt;&lt;/div&gt;"
