        <!-- ===== CELL: TP (True Positive) — bottom-right, EMPHASIZED ===== -->
        <mxCell id="310"
          value="&lt;div style=&quot;font-family:Times New Roman;text-align:center;padding:4px&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;TP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(True Positive)&lt;/font&gt;&lt;hr style=&quot;border:0;border-top:1px solid #888;margin:4px 8px&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Pasien berisiko&lt;br&gt;dan diprediksi&lt;br&gt;berisiko.&lt;/font&gt;&lt;/div&gt;"
