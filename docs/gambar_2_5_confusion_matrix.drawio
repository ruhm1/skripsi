        </mxCell>

        <!-- ===== CELL: FP (False Positive) — top-right ===== -->
        <mxCell id="308"
          value="&lt;div style=&quot;font-family:Times New Roman;text-align:center;padding:4px&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;FP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(False Positive)&lt;/font&gt;&lt;hr style=&quot;border:0;border-top:1px solid #aaa;margin:4px 8px&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Pasien tidak berisiko&lt;br&gt;tetapi diprediksi&lt;br&gt;berisiko.&lt;/font&gt;&lt;/div&gt;"
