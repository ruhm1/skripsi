        <!-- ===== CELL: TN (True Negative) — top-left ===== -->
        <mxCell id="307"
          value="&lt;div style=&quot;font-family:Times New Roman;text-align:center;padding:4px&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;TN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(True Negative)&lt;/font&gt;&lt;hr style=&quot;border:0;border-top:1px solid #aaa;margin:4px 8px&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Pasien tidak berisiko&lt;br&gt;dan diprediksi&lt;br&gt;tidak berisiko.&lt;/font&gt;&lt;/div&gt;"
