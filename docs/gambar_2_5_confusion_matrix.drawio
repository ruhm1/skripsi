          <mxGeometry x="440" y="245" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- ===== FORMULA BOX ===== -->
        <mxCell id="320"
          value="&lt;div style=&quot;font-family:Times New Roman;padding:8px 12px;font-size:10px;line-height:1.7;text-align:left&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:11px;margin-bottom:6px;border-bottom:1.5px solid #333;padding-bottom:4px&quot;&gt;Metrik Evaluasi&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;font-weight:bold;width:90px&quot;&gt;Accuracy&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;= (TP + TN) / (TP + TN + FP + FN)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;font-weight:bold&quot;&gt;Precision&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;= TP / (TP + FP)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;font-weight:bold&quot;&gt;Recall&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;= TP / (TP + FN)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;font-weight:bold&quot;&gt;F1-Score&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;= 2 &amp;#215; (Precision &amp;#215; Recall) / (Precision + Recall)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;arcSize=4;verticalAlign=top;overflow=hidden;"
          vertex="1" parent="1">
