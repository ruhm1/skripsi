graph TB
    class Application {
        +initNavigation()
        +initClock()
        +initECGBanner()
        +initPrediksiForm()
        +loadDashboardStats()
        +loadPatientTable()
    }

    class Dashboard {
        +loadDashboardStats()
        +initDashboardChartsReal(stats)
        +initDashboardChartsFallback()
        -updateStatCards(stats)
        -renderCharts(stats)
    }

    class PatientManager {
        +loadPatientTable()
        +fetchPatients()
        +renderPatientTableAPI(result)
        +goPage(p)
        +showPatientDetail(id)
        +closeModal()
        -patientCurrentPage: int
        -patientSearch: string
        -patientGender: string
        -patientRisiko: string
    }

    class PredictionEngine {
        +selectRadio(el, name)
        +initPrediksiForm()
        +showPredictionResult(result, features)
        -validateInput()
        -formatPath(path)
    }

    class EMRManager {
        +loadEMRDropdown()
        +loadEMRData()
        -renderPatientProfile(data)
        -renderClinicalTimeline(data)
    }

    class ReportManager {
        +loadLaporanCharts()
        +exportCSV()
        +exportExcel()
        +exportPDF()
    }

    class EKGMonitor {
        +loadEKGPage()
        +animateEKG(canvas, color, hr)
    }

    class FlaskAPI {
        +api_stats()
        +api_patients()
        +api_patient_detail(id)
        +api_predict()
        +api_charts()
        +api_report()
        +api_export_csv()
        +api_patient_search()
    }

    class DecisionTreeModel {
        +predict(features)
        +predict_proba(features)
        +decision_path(features)
        -tree: Tree
        -feature_cols: list
        -class_names: list
    }

    class Dataset {
        +load()
        +filter(params)
        +paginate(page, per_page)
        +get_by_id(id)
        -data: DataFrame
        -path: string
    }

    Application --> Dashboard
    Application --> PatientManager
    Application --> PredictionEngine
    Application --> EMRManager
    Application --> ReportManager
    Application --> EKGMonitor
    FlaskAPI --> DecisionTreeModel
    FlaskAPI --> Dataset
    Dashboard --> FlaskAPI
    PatientManager --> FlaskAPI
    PredictionEngine --> FlaskAPI
    EMRManager --> FlaskAPI
    ReportManager --> FlaskAPI